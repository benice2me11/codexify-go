{
  "version": 1,
  "log": {
    "file": ".codexify-go/codexify-go.log",
    "level": "info"
  },
  "service": {
    "name": "CodexifyGo",
    "displayName": "Codexify Go",
    "description": "Native supervisor for Codexify-compatible MCP and OpenAI tunnel runtime."
  },
  "mcp": {
    "workspaceRoot": ".",
    "authEnabled": true,
    "maxRequestBodyBytes": 4194304,
    "diagnostics": {
      "enabled": false,
      "directory": ".codexify-go/diagnostics",
      "maxEvents": 20000,
      "maxDuration": "10m"
    },
    "multiProject": false,
    "projectScanDepth": 2,
    "worktrees": {
      "mode": "auto"
    },
    "projects": [],
    "upstreams": []
  },
  "memory": {
    "enabled": true,
    "maxBytes": 16384
  },
  "skills": {
    "enabled": true,
    "includeUser": true,
    "includePlugins": true,
    "claudePlugins": false,
    "dirs": []
  },
  "projectDoc": {
    "maxBytes": 32768,
    "fallbackFilenames": [],
    "rootMarkers": [".git"]
  },
  "diff": {
    "maxPatchBytes": 4194304
  },
  "artifactIngress": {
    "enabled": true,
    "maxFileBytes": 104857600,
    "requestTimeout": "2m",
    "idleTimeout": "30s",
    "maxRedirects": 3,
    "maxConcurrentDownloads": 2,
    "allowedHosts": ["*"]
  },
  "artifactEgress": {
    "enabled": true,
    "maxFileBytes": 104857600,
    "snapshotMaxFileBytes": 104857600,
    "maxSnapshotBytes": 5368709120,
    "fallbackToSource": true,
    "maxReferences": 64,
    "referenceTtl": "5m"
  },
  "agentChat": {
    "enabled": false,
    "maxWaitMs": 55000
  },
  "experimental": {
    "agentTickets": false
  },
  "tunnel": {
    "managedDir": ".codexify-go/openai-tunnel",
    "tunnelId": "tunnel_REPLACE_ME",
    "apiKeyRef": "file:.codexify-go/tunnel.key",
    "mcpServerUrl": "http://127.0.0.1:3300/mcp/tunnel_REPLACE_ME",
    "startupWaitTimeout": "15s",
    "healthUrlFile": ".codexify-go/tunnel-health.url",
    "environment": {},
    "extraArgs": []
  },
  "supervisor": {
    "minBackoff": "2s",
    "maxBackoff": "1m",
    "stableWindow": "1m",
    "healthInterval": "5s",
    "healthFailureThreshold": 3,
    "shutdownTimeout": "10s"
  }
}
